{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudflare Private Notes",
  "version": "1.0.0",
  "identifier": "com.jiayaogege.cloudflarenotes",
  "build": {
    "beforeDevCommand": "pnpm dev --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudflare Private Notes",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://notes.goho.eu.org",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  }
}
